        "max_length": 500
      }
    },
    {
      "id": "q_next_standard_question",
      "type": "binary",
      "text": "Do you prefer written feedback over verbal feedback?",
      "options": [
        { "id": "opt_yes", "label": "Yes", "value": "opt_yes" },
        { "id": "opt_no", "label": "No", "value": "opt_no" }
      ]
    }
  ],
  "logic_edges": [
