  "nodes": [
    {
      "id": "q_context_switch_1",
      "type": "single_choice",
      "text": "When interrupted during a state of deep focus, how long does it take you to resume your task?",
      "options": [
        { "id": "opt_1", "label": "A few seconds to a minute", "value": "opt_1" },
        { "id": "opt_2", "label": "Several minutes", "value": "opt_2" },
        { "id": "opt_3", "label": "It often derails my entire workflow", "value": "opt_3" }
      ],
      "ui_config": {
        "allow_audio_response": false,
        "show_clarification_tooltip": "Deep focus means you are fully absorbed in a task and losing track of time."
      }
    },
    {
      "id": "q_derail_elaboration",
      "type": "open_text",
      "text": "You mentioned interruptions derail your workflow. Can you describe what type of interruptions are the most disruptive?",
